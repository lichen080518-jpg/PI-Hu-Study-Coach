# Set two different passcodes, at least 12 characters each.
TUTOR_REVIEWER_PASSCODE=
TUTOR_STUDENT_PASSCODE=
TUTOR_PORT=8787
# TUTOR_DATA_DIR=C:/data/hu-study-coach
# TUTOR_PUBLIC_ORIGIN=https://tutor.home.arpa
# TUTOR_WEEKLY_ENABLED=0

# Provider and model settings can also be changed by a reviewer in the web app.
# TUTOR_MODEL_PROVIDER=openai-codex
# TUTOR_CODEX_MODEL=gpt-6.1-sol
# TUTOR_CODEX_REASONING_LEVEL=low
# TUTOR_CODEX_AUTH_FILE=C:/path/to/auth.json

# Use a locally installed OpenAI-compatible model. Set the exact model ID.
# TUTOR_MODEL=
# TUTOR_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# TUTOR_MODEL_VISION=1
# TUTOR_MODEL_STRUCTURED_GRADING=1
# TUTOR_MODEL_API_KEY=
# TUTOR_ALLOW_CLOUD=1

# Override the detected Chromium, Chrome, or Edge executable if needed.
# TUTOR_CHROMIUM_PATH=
